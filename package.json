{
  "name": "doqto",
  "private": true,
  "description": "Doqto Phase 1 monorepo: apps/web (Next.js PWA), apps/api (NestJS), packages/shared (API contract)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive --if-present run dev",
    "dev:free": "node scripts/ops/free-dev-ports.mjs",
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:tooling && pnpm --recursive --if-present run test",
    "test:tooling": "node --test \"tooling/**/*.test.mjs\"",
    "test:e2e": "pnpm --recursive --if-present run test:e2e",
    "ci:local": "node scripts/ops/ci-local.mjs",
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.0",
    "@types/node": "^22.18.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
