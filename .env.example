# Doqto environment variables (Phase 1). Copy to .env for local development.
# Defaults below run everything locally in demo mode. Real secrets live only in
# Render / Vercel environment settings, never in this file or in git.
# Env matrix per environment (local, demo, production): infra/ENVIRONMENTS.md

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Port the NestJS API listens on (Render injects PORT in hosted environments).
PORT=4000
# Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# Version string reported by GET /api/v1/health (CI or Render sets the git sha).
APP_VERSION=dev
# Business timezone for IST day boundaries, slots and end-of-day jobs.
APP_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Demo vs live providers (TDD section 13)
# ---------------------------------------------------------------------------
# demo: fixed OTP 123456, messages go to the outbox / Demo inbox only, mock payment,
#       local file storage. Requires MONGODB_DB_NAME starting with doqto_demo.
# live: real WhatsApp BSP, MSG91, Razorpay and R2. Requires every live key below.
# Read once at startup; nothing at runtime can switch it.
PROVIDER_MODE=demo

# ---------------------------------------------------------------------------
# URLs and CORS
# ---------------------------------------------------------------------------
# Public base URL of this API (used in webhook URLs and links in messages).
API_PUBLIC_URL=http://localhost:4000
# Public base URL of the web app (used for live-status links in WhatsApp messages).
WEB_PUBLIC_URL=http://localhost:3000
# Comma-separated origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:3010
# Cookie domain for auth cookies; leave empty on localhost. Production: .doqto.in
COOKIE_DOMAIN=
# Number of proxies in front of the API, for client IPs in rate limits:
# 0 locally, 1 on Render, 2 behind Cloudflare + Render. 2 is spoofable via X-Forwarded-For
# until INT-11 locks the Render origin to Cloudflare.
TRUST_PROXY=0
# Header carrying the real client IP, e.g. cf-connecting-ip behind Cloudflare; empty uses
# TRUST_PROXY. Spoofable while the Render origin accepts direct traffic, so set it only after
# INT-11 locks the origin to Cloudflare.
CLIENT_IP_HEADER=

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Connection string. Local: docker compose (single-node replica set rs0).
# MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_URI=mongodb+srv://raunakali1995:21997017@cluster0.dpvb1js.mongodb.net/
# Database name. Must start with doqto_demo when PROVIDER_MODE=demo (INT-03).
# Production uses doqto_prod.
MONGODB_DB_NAME=doqto_demo_local

# ---------------------------------------------------------------------------
# Auth and hashing
# ---------------------------------------------------------------------------
# HMAC secret for 15-minute access JWTs. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-local-only-access-secret-at-least-32-chars
# Access token lifetime (TDD 11: 15 minutes).
JWT_ACCESS_TTL=15m
# Refresh token lifetime in days (TDD 11: 30 days, rotated on use).
REFRESH_TOKEN_TTL_DAYS=30
# Pepper mixed into hashes of OTPs, visit codes, refresh tokens and device
# fingerprints. Changing it invalidates all of them. openssl rand -base64 32
HASH_PEPPER=change-me-local-only-hash-pepper
# Tests only: path to a local mongod 8.x for the in-memory e2e database, when
# fastdl.mongodb.org cannot be reached. Leave unset to download automatically.
# MONGOMS_SYSTEM_BINARY=/usr/local/bin/mongod

# Rate limit defaults for @nestjs/throttler (requests per window, window in seconds).
THROTTLE_LIMIT=100
THROTTLE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# WhatsApp BSP (live only; INT-20). Unused in demo mode.
# ---------------------------------------------------------------------------
# aisensy | interakt, whichever approves the business number first.
WHATSAPP_BSP=
# BSP API key / token (from the BSP dashboard). Live only.
WHATSAPP_API_KEY=
# BSP API base URL (if the BSP needs one per account).
WHATSAPP_API_BASE_URL=
# Secret used to verify BSP webhook signatures (INT-10).
WHATSAPP_WEBHOOK_SECRET=
# Meta Cloud API webhook check: any string you choose; type the same one in Meta's "Verify token" box.
# The "App Secret" (Meta app > Settings > Basic) goes in WHATSAPP_WEBHOOK_SECRET above.
WHATSAPP_VERIFY_TOKEN=
# Meta Cloud API sender. Set WHATSAPP_BSP=meta, WHATSAPP_API_KEY=<access token>, then:
# the Phone Number ID (WhatsApp > API Setup; not the phone number itself) and the account id.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Demo mode with Meta: only these E.164 numbers (comma separated) get real WhatsApp messages;
# everyone else stays on the demo provider. OTP login always stays on the demo provider.
WHATSAPP_TEST_RECIPIENTS=
# true on Meta's free test account (it cannot hold custom templates): send plain text instead.
# Delivered only within 24 hours of the patient messaging the number. Remove for real use.
WHATSAPP_SEND_AS_TEXT=
# The WhatsApp Business API sender number in E.164, e.g. +9198xxxxxxxx.
WHATSAPP_SENDER_NUMBER=

# ---------------------------------------------------------------------------
# MSG91 SMS fallback (live only; INT-20). Unused in demo mode.
# ---------------------------------------------------------------------------
# MSG91 API auth key (MSG91 dashboard > API). Live only.
MSG91_AUTH_KEY=
# DLT-registered 6-character sender id.
MSG91_SENDER_ID=
# DLT entity id of the business.
MSG91_DLT_ENTITY_ID=
# MSG91 template id for the login / visit OTP SMS.
MSG91_OTP_TEMPLATE_ID=

# ---------------------------------------------------------------------------
# Razorpay (live only; INT-13, INT-14). Test-mode keys work without KYC.
# ---------------------------------------------------------------------------
# Razorpay key id (Dashboard > Settings > API Keys). With PROVIDER_MODE=demo and a rzp_test_... key
# (plus the secret below) the API uses the real Razorpay TEST gateway: no money moves. Leave empty to
# use the built-in demo gateway. Example placeholder: rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=
# Razorpay key secret, shown once when the key is generated; signs checkout. Live only.
RAZORPAY_KEY_SECRET=
# Secret set on the Razorpay webhook in the dashboard (verifies /webhooks/razorpay).
RAZORPAY_WEBHOOK_SECRET=
# Booking fee in paise (1500 = Rs 15).
BOOKING_FEE_PAISE=1500

# Labs may upload test reports into Doqto's storage. ADR 0007 keeps clinical data out until the
# data-protection (DPDP) review is done, so leave this unset or false in live mode. Unset means on in
# demo mode and off otherwise.
# LAB_REPORTS_ENABLED=false

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Demo: local folder for uploads (doctor photos, credential scans).
DEMO_STORAGE_DIR=.demo-storage
# Live: Cloudflare R2 (S3 API) (INT-06).
# Cloudflare account id (R2 endpoint is https://<id>.r2.cloudflarestorage.com). Live only.
R2_ACCOUNT_ID=
# R2 API token access key id (R2 > Manage API tokens, object read/write). Live only.
R2_ACCESS_KEY_ID=
# R2 API token secret access key, shown once at creation. Live only.
R2_SECRET_ACCESS_KEY=
# Public bucket name for doctor and clinic photos. Live only.
R2_PUBLIC_BUCKET=
# Public base URL of that bucket (r2.dev URL or a custom domain). Live only.
R2_PUBLIC_BASE_URL=
# Private bucket name for credential scans, served only by signed URLs. Live only.
R2_PRIVATE_BUCKET=
# Signed URL lifetime in seconds (TDD 11: 5 minutes).
SIGNED_URL_TTL_SECONDS=300
# Private bucket for nightly mongodump backups (INT-17).
R2_BACKUP_BUCKET=

# ---------------------------------------------------------------------------
# Maps (INT-07): free geocoding only, no paid map API in Phase 1
# ---------------------------------------------------------------------------
# User-Agent sent to the free geocoder (Nominatim policy requires a contact).
GEOCODER_USER_AGENT=Doqto/0.1 (contact@doqto.in)

# ---------------------------------------------------------------------------
# Web Push (INT-16)
# ---------------------------------------------------------------------------
# VAPID public key for Web Push; generate the pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
# VAPID private key from the same pair; server only, never NEXT_PUBLIC.
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https: URL).
VAPID_SUBJECT=mailto:contact@doqto.in

# ---------------------------------------------------------------------------
# Monitoring (INT-18)
# ---------------------------------------------------------------------------
# Sentry DSN for the API; empty disables Sentry.
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Web app (apps/web). NEXT_PUBLIC_* values are visible to browsers.
# ---------------------------------------------------------------------------
# API base URL the browser calls (includes /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Shows the demo banner and demo hints (OTP 123456, Demo inbox, demo pay button).
NEXT_PUBLIC_DEMO_MODE=true
# Serve API calls from MSW mocks generated from packages/shared (FE-03).
NEXT_PUBLIC_API_MOCKS=false
# Book, pay, review and list appointments through the real API instead of the on-device demo store.
NEXT_PUBLIC_BOOKING_API=true
# Server-side only: when set, the web app proxies /api/v1/* to this API origin so
# browsers call it same-origin (demo deployment; see infra/ENVIRONMENTS.md).
API_PROXY_TARGET=
# Public site URL for canonical links, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The console (apps/console, port 3010): doctors, clinics, labs, pharmacies and the Doqto team.
# Other apps link to these, e.g. "For doctors" on the patient site.
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3010
# Razorpay key id for Checkout (live mode only; never the secret).
# Razorpay key id for Checkout. Normally not needed: the API sends the key with each order.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# VAPID public key for Web Push subscription (same value as VAPID_PUBLIC_KEY).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Sentry DSN for the browser; empty disables it.
NEXT_PUBLIC_SENTRY_DSN=

# --- Doqto team (admin) login: the same console login page, then the /admin area ---
# When both are set, the API creates or updates this team account at every start, so to change the
# admin login edit these two lines and restart the API. Leave both empty to manage admins with
# `pnpm --filter @doqto/api admin:create <email> "<Full Name>"` instead.
# The password needs 10+ characters with a letter and a number. Use a strong one outside demo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Doqto Admin
